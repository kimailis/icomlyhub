generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  password               String
  name                   String?
  role                   String               @default("free")
  createdAt              DateTime             @default(now())
  bio                    String?
  profilePath            String?
  stripeCustomerId       String?              @unique
  stripeSubscriptionId   String?              @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  notificationSettings   String?
  profileFolder          String?
  comments               Comment[]
  following              Follow[]
  likes                  Like[]
  sentNotifications      Notification[]       @relation("SentNotifications")
  notifications          Notification[]       @relation("UserNotifications")
  passwordResetTokens    PasswordResetToken[]
  receivedPosts          Post[]               @relation("ReceivedPosts")
  posts                  Post[]               @relation("UserPosts")
  userFollowing          UserFollow[]         @relation("UserToUserFollowing")
  userFollowers          UserFollow[]         @relation("UserToUserFollowers")
}

model Notification {
  id        String   @id @default(uuid())
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  senderId  String?
  postId    String?
  commentId String?
  sender    User?    @relation("SentNotifications", fields: [senderId], references: [id])
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt(sort: Desc)])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserFollow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserToUserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserToUserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id              String     @id @default(uuid())
  content         String
  picPath         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  userId          String
  targetUserId    String?
  targetCelebId   String?
  baseRating      Int        @default(0)
  verified        Boolean    @default(false)
  isFeedCandidate Boolean    @default(false)
  comments        Comment[]
  likes           Like[]
  targetCeleb     Celebrity? @relation(fields: [targetCelebId], references: [id], onDelete: Cascade)
  targetUser      User?      @relation("ReceivedPosts", fields: [targetUserId], references: [id], onDelete: Cascade)
  user            User       @relation("UserPosts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([targetUserId])
  @@index([targetCelebId])
  @@index([createdAt(sort: Desc)])
  @@index([isFeedCandidate, verified])
}

model Comment {
  id         String    @id @default(uuid())
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String
  postId     String?
  articleId  String?
  sightingId String?
  article    Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  sighting   Sighting? @relation(fields: [sightingId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes      Like[]

  @@index([userId])
  @@index([postId])
  @@index([articleId])
  @@index([sightingId])
}

model Like {
  id         String    @id @default(uuid())
  createdAt  DateTime  @default(now())
  isUpvote   Boolean   @default(true)
  userId     String
  postId     String?
  commentId  String?
  articleId  String?
  sightingId String?
  article    Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  comment    Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  sighting   Sighting? @relation(fields: [sightingId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@unique([userId, articleId])
  @@unique([userId, sightingId])
}

model Celebrity {
  id                 String          @id
  name               String
  bio                String
  imageUrl           String
  noiseRating        Int
  trendDirection     String
  lastUpdated        DateTime        @default(now())
  followerCount      Int             @default(0)
  lifeSummary        String?
  hobbies            String?
  relationshipStatus String?
  bioLastUpdated     DateTime?
  nationality        String?
  country            String?
  region             String?
  primaryCity        String?
  category           String?
  verified           Boolean         @default(false)
  articles           Article[]
  osintData          CelebrityOsint?
  followers          Follow[]
  noiseHistory       NoiseHistory[]
  posts              Post[]
  sightings          Sighting[]

  @@index([noiseRating(sort: Desc)])
  @@index([lastUpdated])
  @@index([country])
  @@index([region])
}

model CelebrityOsint {
  id               String    @id @default(uuid())
  celebrityId      String    @unique
  reportedPhone    String?
  currentAddress   String?
  currentCar       String?
  frequentedPlaces String?
  socialHandles    String?
  additionalIntel  String?
  lastUpdated      DateTime  @default(now())
  dataQuality      Int       @default(50)
  celebrity        Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  @@index([celebrityId])
}

model Article {
  id          String    @id @default(uuid())
  headline    String
  summary     String
  source      String
  sourceUrl   String
  publishedAt DateTime
  impactScore Int
  category    String
  celebrityId String
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]

  @@index([celebrityId])
  @@index([publishedAt(sort: Desc)])
  @@index([impactScore(sort: Desc)])
}

model Sighting {
  id          String    @id @default(uuid())
  location    String
  lat         Float
  lng         Float
  confidence  Float
  date        DateTime
  snippet     String
  country     String?
  region      String?
  city        String?
  verified    Boolean   @default(false)
  celebrityId String
  comments    Comment[]
  likes       Like[]
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  @@index([date(sort: Desc)])
  @@index([celebrityId, date(sort: Desc)])
  @@index([lat, lng])
  @@index([country])
  @@index([region])
  @@index([verified])
}

model NoiseHistory {
  id          String    @id @default(uuid())
  score       Int
  date        DateTime  @default(now())
  celebrityId String
  celebrity   Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)

  @@index([celebrityId, date(sort: Desc)])
  @@index([date])
}

model DailyStats {
  id             String   @id @default(uuid())
  date           DateTime @unique @default(now())
  totalArticles  Int      @default(0)
  totalSightings Int      @default(0)
  avgNoiseRating Float    @default(0)
  topCelebId     String?
  topCategory    String?

  @@index([date(sort: Desc)])
}

model Follow {
  userId       String
  celebrityId  String
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime  @default(now())
  celebrity    Celebrity @relation(fields: [celebrityId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, celebrityId])
  @@index([userId])
  @@index([celebrityId])
}
