# Cost-Optimized Configuration for Icomly

# ============================================
# GEMINI API (Primary Cost Driver)
# ============================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash  # Use Flash (10x cheaper than Pro)

# ============================================
# DATABASE (Use Free Tier)
# ============================================
# Option 1: Supabase (FREE up to 500MB)
DATABASE_URL=postgresql://postgres:[password]@db.supabase.co:5432/postgres

# Option 2: Neon (FREE up to 3GB)
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb

# Option 3: Self-hosted (if you have existing infrastructure)
# DATABASE_URL=postgresql://user:password@localhost:5432/icomly

# ============================================
# REDIS (Use Free Tier)
# ============================================
# Option 1: Upstash (FREE 10,000 commands/day)
REDIS_URL=https://your-db.upstash.io
REDIS_TOKEN=your_upstash_token

# Option 2: Redis Cloud (FREE 30MB)
# REDIS_HOST=redis-xxxxx.cloud.redislabs.com
# REDIS_PORT=xxxxx
# REDIS_PASSWORD=your_password

# Option 3: Self-hosted
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ============================================
# JOB SCHEDULING (Optimized Frequencies)
# ============================================
# Reduce frequency to save API costs
FEED_GENERATION_INTERVAL=*/15 * * * *  # Every 15 min (was 5)
PROFILE_REFRESH_INTERVAL=*/30 * * * *  # Every 30 min (was 5)
TREND_ANALYSIS_INTERVAL=0 */12 * * *   # Every 12 hours (was 6)
CLEANUP_INTERVAL=0 3 * * *             # Daily at 3 AM

# ============================================
# BATCH SIZES (Reduce to save costs)
# ============================================
ARTICLES_PER_GENERATION=5              # Generate 5 articles (was 10)
PROFILES_PER_REFRESH=5                 # Update 5 profiles (was 10)
MAX_FEED_ITEMS=30                      # Show 30 items (was 50)

# ============================================
# CACHE SETTINGS (Optimize TTL)
# ============================================
CACHE_FEED_TTL=600                     # 10 minutes (was 900)
CACHE_CELEBS_TTL=1200                  # 20 minutes (was 1800)
CACHE_PROFILE_TTL=1800                 # 30 minutes (was 3600)
CACHE_MAP_TTL=1800                     # 30 minutes

# ============================================
# DATA RETENTION (Aggressive Cleanup)
# ============================================
ARTICLE_RETENTION_DAYS=3               # Keep 3 days (was 7)
SIGHTING_RETENTION_DAYS=3              # Keep 3 days (was 7)
NOISE_HISTORY_RETENTION_DAYS=7         # Keep 7 days (was 30)
INACTIVE_CELEB_DAYS=14                 # Remove after 14 days (was 30)

# ============================================
# FEATURE FLAGS (Disable Expensive Features)
# ============================================
ENABLE_AI_BIO_GENERATION=false         # Use pre-generated bios
ENABLE_AI_SIGHTING_GENERATION=false    # Use template-based sightings
ENABLE_WIKIPEDIA_IMAGE_FETCH=true      # Keep (it's free)
ENABLE_GEMINI_CACHING=true             # Enable response caching

# ============================================
# COST MONITORING
# ============================================
ENABLE_COST_TRACKING=true              # Track API usage and costs
COST_ALERT_THRESHOLD=10                # Alert if daily cost > $10
COST_REPORT_EMAIL=admin@icomly.com   # Send daily cost reports

# ============================================
# JWT & SECURITY
# ============================================
JWT_SECRET=your_secure_jwt_secret_change_me_in_production

# ============================================
# DEPLOYMENT (Free/Low-Cost Options)
# ============================================
# Frontend: Deploy to Vercel (FREE)
# Backend: Deploy to Railway ($5/month) or Render (FREE tier)
# Database: Supabase or Neon (FREE tier)
# Redis: Upstash (FREE tier)
# Total: $0-5/month

PORT=3001
NODE_ENV=production

# ============================================
# OPTIONAL: CDN for Images
# ============================================
# Use Cloudflare CDN (FREE) for celebrity images
# CDN_URL=https://cdn.icomly.com
# CLOUDFLARE_ZONE_ID=your_zone_id
# CLOUDFLARE_API_TOKEN=your_api_token

# ============================================
# ESTIMATED MONTHLY COSTS
# ============================================
# With these optimizations:
# - Gemini API: $2-5/month (90% reduction)
# - Database: $0 (free tier)
# - Redis: $0 (free tier)
# - Hosting: $0-5/month
# TOTAL: $2-10/month (vs $61-246 unoptimized)
